{
  "name": "accounting",
  "private": true,
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "migrate": "pnpm --filter @acct/db migrate",
    "migrate:new": "pnpm --filter @acct/db generate",
    "seed": "pnpm --filter @acct/db seed",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "scan:secrets:all": "node scripts/scan-secrets.mjs --all"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.7.3",
    "@types/node": "^22.13.0",
    "vitest": "^3.0.5",
    "eslint": "^9.19.0",
    "tsx": "^4.19.2"
  }
}
