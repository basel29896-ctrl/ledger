# Copy to .env before `make dev`. Every variable here is validated at boot
# by packages/shared/src/env.ts; a missing or malformed value stops the app.

NODE_ENV=development
LOG_LEVEL=info

# --- API ---
API_PORT=4000

# --- Postgres ---
POSTGRES_USER=accounting
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=accounting
DATABASE_URL=postgresql://accounting:change-me-locally@postgres:5432/accounting
DATABASE_MAX_CONNECTIONS=10

# --- Redis (BullMQ) ---
REDIS_URL=redis://redis:6379

# --- MinIO / S3 (attachments, generated PDFs) ---
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=accounting
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- SMTP (Mailhog in dev) ---
SMTP_HOST=mailhog
SMTP_PORT=1025

# --- Accounting defaults ---
DEFAULT_BASE_CURRENCY=JOD

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- JoFotara e-invoicing (M7). Never commit real credentials. ---
JOFOTARA_CLIENT_ID=
JOFOTARA_SECRET_KEY=

# Host port for the web dev server. Change only if 3000 is taken locally.
WEB_PORT=3000
